\item{scope}{\code{"full"} or \code{"answered"}; see Eligibility.}
\item{min_overlap}{Pairs need overlap strictly greater than this.}
\item{min_episode_time}{Minimum counted event time for eligibility.}
\item{learning_period}{Time at the start of each record excluded from
